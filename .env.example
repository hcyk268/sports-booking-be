# 1. APPLICATION & SERVER
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
BOOKING_ZONE_ID=Asia/Ho_Chi_Minh
BOOKING_HOLD_DURATION=10m
BOOKING_LOCK_TTL=30s
BOOKING_EXPIRY_POLL_INTERVAL=15s
BOOKING_EXPIRY_ENABLED=true


# 2. POSTGRESQL CONFIGURATION
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=


# 3. REDIS CONFIGURATION
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=


# 4. RABBITMQ CONFIGURATION
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=


# 5. SECURITY & JWT
# token HMAC-SHA (at least 256-bit / 32 bytes)
JWT_SECRET_ACCESS_TOKEN=
JWT_SECRET_REFRESH_TOKEN=
# 900000 ms = 15m
JWT_ACCESS_TOKEN_EXPIRATION_MS=
# 604800000 ms = 7d
JWT_REFRESH_TOKEN_EXPIRATION_MS=


# 5b. FRONTEND (email activation link)
APP_FRONTEND_BASE_URL=http://localhost:3000


# 6. EMAIL SERVICE (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=


# 7. CLOUD STORAGE Cloudflare R2
# Enable only after creating the private bucket and configuring CORS/lifecycle.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# 8. SEPAY GATEWAY (checkout signing; do not use production keys in local tests)
SEPAY_ENABLED=false
SEPAY_ENVIRONMENT=SANDBOX
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Public return URLs owned by the frontend; never proof that payment succeeded.
SEPAY_SUCCESS_URL=
SEPAY_ERROR_URL=
SEPAY_CANCEL_URL=
# Confirm the timezone SePay uses for transaction.transaction_date in your merchant environment.
SEPAY_TRANSACTION_ZONE_ID=Asia/Ho_Chi_Minh
# Pending-payment slots remain reserved for this long after the original checkout deadline.
PAYMENT_SETTLEMENT_GRACE=2m

# 9. PAYMENT INBOX WORKER (independent of checkout enablement)
PAYMENT_INBOX_ENABLED=true
PAYMENT_INBOX_POLL_INTERVAL=1s

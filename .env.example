# 1. APPLICATION & SERVER
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080


# 2. POSTGRESQL CONFIGURATION
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=


# 3. REDIS CONFIGURATION
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=


# 4. RABBITMQ CONFIGURATION
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=


# 5. SECURITY & JWT
# token HMAC-SHA (at least 256-bit / 32 bytes)
JWT_SECRET_ACCESS_TOKEN=
JWT_SECRET_REFRESH_TOKEN=
# 900000 ms = 15m
JWT_ACCESS_TOKEN_EXPIRATION_MS=
# 604800000 ms = 7d
JWT_REFRESH_TOKEN_EXPIRATION_MS=


# 5b. FRONTEND (email activation link)
APP_FRONTEND_BASE_URL=http://localhost:3000


# 6. EMAIL SERVICE (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=


# 7. CLOUD STORAGE Cloudflare R2
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
